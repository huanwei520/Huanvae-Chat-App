{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev-remote-localhost",
  "description": "仅 macOS 调试用：允许从 http://localhost (Vite dev server) 载入的页面调用 Tauri IPC。生产构建加载 tauri:// 本地资源，remote.urls 不会匹配，因此此 capability 在正式版中处于惰性、无效果。",
  "platforms": ["macOS"],
  "windows": ["main", "meeting", "media", "lan-transfer", "theme-editor", "lowcode-editor", "editor", "huanvae-guard"],
  "remote": {
    "urls": ["http://localhost:*", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-stat",
    "fs:read-all",
    "dialog:default",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:default",
    "process:allow-restart",
    "process:allow-exit",
    "os:default",
    "os:allow-hostname",
    "os:allow-arch",
    "os:allow-platform",
    "os:allow-version",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "core:window:allow-inner-size",
    "core:window:allow-outer-size",
    "core:window:allow-start-dragging",
    "core:webview:allow-create-webview-window",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    {
      "identifier": "fs:scope",
      "allow": [
        "$DATA/**",
        "$LOCALDATA/**",
        "$APPDATA/**",
        "$HOME/.local/share/huanvae-chat/**",
        "$PICTURE/**",
        "$VIDEO/**",
        "$DOCUMENT/**",
        "$DOWNLOAD/**",
        "$DESKTOP/**",
        "$HOME/**"
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*/**" },
        { "url": "https://*:*/**" },
        { "url": "http://*/**" },
        { "url": "https://*/**" }
      ]
    }
  ]
}
