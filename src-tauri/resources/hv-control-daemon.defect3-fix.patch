+    }
+}
+
+/// 注入汇真实实现:0x06 decode → plan → XTEST(经 GatedSink 门禁包装)。
+struct XtestSink {
+    backend: Arc<BackendSlot>,
+}
+
+impl InputSink for XtestSink {
+    /// unix:0x06 decode → 本端 keymap 换 keycode → plan → XTEST 注入。
+    #[cfg(unix)]
+    fn deliver(&self, wire: &[u8]) -> Result<(), String> {
+        let mut msg = mapping::decode_input_event(wire).map_err(|e| format!("0x06 decode: {e}"))?;
+        // keys 域 wire 语义 = keysym 低 16 位（§7.2 最小键位表，客户端产出）；
+        // 注入前查本端 keymap 换 keycode（键码是本机 keymap 属性，不能跨端假设）。
+        // 表外 keysym 丢弃并 eprintln 留痕（门禁/注入判定行仍由 GatedSink 审计承载）。
+        if let SessionMsg::InputEvent { keys, .. } = &mut msg {
+            if !keys.is_empty() {
+                let (mapped, dropped) = self.backend.with(|b| {
+                    crate::keys::translate_keysym_keys(keys, &|ks| b.keysym_to_keycode(ks))
+                })?;
+                if dropped > 0 {
+                    eprintln!("[daemon] keysym translate: {dropped} unmapped keysym(s) dropped");
+                }
+                *keys = mapped;
+            }
+        }
+        let cmds = mapping::plan(&msg).map_err(|e| e.to_string())?;
+        self.backend
+            .with(|b| b.inject(&cmds))?
+            .map_err(|e| e.to_string())
+    }
+
+    /// 非 unix:无桌面后端可注入,按调用返回明确错误(先于任何载荷解析,从严拒绝;
+    /// GatedSink 门禁判定行/审计留痕不变)。
+    #[cfg(not(unix))]
+    fn deliver(&self, _wire: &[u8]) -> Result<(), String> {
+        Err(self.backend.unavailable())
+    }
+}
+
+struct Args {
+    bind: String,
+    session_bind: String,
+    fp_dir: Option<String>,
+    audit: Option<String>,
+    profile: CaptureProfile,
+}
+
+fn parse_args() -> Result<Args, String> {
+    let mut bind: Option<String> = None;
+    let mut session_bind: Option<String> = None;
+    let mut fp_dir = None;
+    let mut audit = None;
+    let mut max_w = 960u32;
+    let mut fps = 8u32;
+    // std::env::args() 对非 UTF-8 参数会 panic(#[track_caller] → panic Location
+    // 会把本文件路径串编入分发件——卡面判据之一);改用 args_os 逐参显式转
+    // String,非 UTF-8 参数按解析错误走显式 exit=1,不 panic。
+    let mut it = std::env::args_os().skip(1);
+    while let Some(a) = it.next() {
+        let a = a
+            .into_string()
+            .map_err(|_| "non-UTF-8 argument (arguments must be UTF-8)".to_string())?;
+        match a.as_str() {
+            "--bind" => bind = it.next().and_then(|s| s.into_string().ok()),
+            "--session-bind" => session_bind = it.next().and_then(|s| s.into_string().ok()),
+            "--fp-dir" => fp_dir = it.next().and_then(|s| s.into_string().ok()),
+            "--audit" => audit = it.next().and_then(|s| s.into_string().ok()),
+            "--max-w" => max_w = it.next().and_then(|s| s.into_string().ok()).ok_or("--max-w needs value")?.parse().map_err(|_| "bad --max-w")?,
+            "--fps" => fps = it.next().and_then(|s| s.into_string().ok()).ok_or("--fps needs value")?.parse().map_err(|_| "bad --fps")?,
+            other => return Err(format!("unknown arg {other:?}")),
+        }
+    }
+    Ok(Args {
+        bind: bind.ok_or("missing --bind <loopback IP:port>")?,
+        session_bind: session_bind.ok_or("missing --session-bind <loopback IP:port>")?,
+        fp_dir,
+        audit,
+        profile: CaptureProfile { max_w, fps },
+    })
+}
+
+/// bin 薄入口(退出码语义不变:0 正常停机/2 绑定策略拒绝/1 运行时失败)。
+pub fn main_entry() -> ExitCode {
+    let args = match parse_args() {
+        Ok(a) => a,
+        Err(e) => {
+            eprintln!("[daemon] {e}; usage: hv-control-daemon --bind <loopback IP:port> --session-bind <loopback IP:port> [--fp-dir DIR] [--audit PATH] [--max-w N] [--fps N]");
+            return ExitCode::from(1);
+        }
+    };
+
+    // ── 红线:绑定策略校验先于一切(含 X 连接与 OS bind;Y.1 形态)──
+    for spec in [&args.bind, &args.session_bind] {
+        if let Err(e) = bind::resolve_loopback_bind(spec) {
+            eprintln!("[daemon] BIND-POLICY-REJECTED: {e}");
+            return ExitCode::from(2);
+        }
+    }
+
+    let killswitch = KillSwitch::new();
+    let audit = match &args.audit {
+        Some(p) => crate::audit::AuditLog::with_file(std::path::Path::new(p)),
+        None => crate::audit::AuditLog::new(),
+    };
+    let shared = DaemonShared::new(killswitch.clone(), args.profile, audit);
+
+    // ── tokio runtime(会话通道侧;控制面为 std 线程)──
+    let rt = tokio::runtime::Builder::new_multi_thread().enable_all().build();
+    let rt = match rt {
+        Ok(r) => Arc::new(r),
+        Err(e) => {
+            eprintln!("[daemon] tokio runtime: {e}");
+            return ExitCode::from(1);
+        }
+    };
+
+    // ── 桌面后端:惰性 + 可失败(X11 平台外不阻断控制面)──
+    let backend = Arc::new(BackendSlot::new());
+    if backend.try_connect() {
+        if let Some((w, h)) = backend.describe() {
+            eprintln!("[daemon] backend connected: screen {w}x{h}, unix-socket only");
+        }
+    } else {
+        let why = backend.last_error().unwrap_or_else(|| "unknown".into());
+        eprintln!(
+            "[daemon] WARNING: desktop backend unavailable ({why}); control plane (arm/disarm/incoming/status/killswitch) and P3 session channel continue serving; capture/inject endpoints return explicit errors"
+        );
+    }
+
+    // ── 回环控制面(HTTP)──
+    let frames: Arc<dyn FrameSource> = Arc::new(X11Frames {
+        backend: backend.clone(),
+        max_w: args.profile.max_w,
+        shared: shared.clone(),
+    });
+    // 回环注入汇(§7.2 键鼠回传):GatedSink 门禁包装 XtestSink,置入 shared。
+    {
+        use crate::input_gate::GatedSink;
+        let gated: Arc<dyn hv_demo_http::http::InputSink> = Arc::new(GatedSink {
+            gate: shared.gate.clone(),
+            inner: XtestSink { backend: backend.clone() },
+            audit: shared.audit.clone(),
+            delivered: Arc::new(std::sync::atomic::AtomicU64::new(0)),
+        });
+        shared.set_sink(gated);
+    }
+    let control = match ControlServer::bind(&args.bind, shared.clone(), frames) {
+        Ok(s) => s,
+        Err(e) => {
+            eprintln!("[daemon] BIND-POLICY-REJECTED: {e}");
+            return ExitCode::from(2);
+        }
+    };
+    let control_addr = control.local_addr();
+    control.spawn();
+
+    // ── P3 会话通道(acceptor)──
+    let session_addr = match bind::resolve_loopback_bind(&args.session_bind) {
+        Ok(a) => a,
+        Err(e) => {
+            eprintln!("[daemon] BIND-POLICY-REJECTED: {e}");
+            return ExitCode::from(2);
+        }
+    };
+    {
+        let shared = shared.clone();
+        let backend = backend.clone();
+        let fp_source = args
+            .fp_dir
+            .as_ref()
+            .map(|d| DirFpSource::new(std::path::Path::new(d)))
+            .unwrap_or_else(|| DirFpSource::new(std::path::Path::new("/tmp/hv-control-fp-demo")));
+        rt.spawn(async move {
+            run_session_acceptor(session_addr, shared, backend, fp_source).await;
+        });
+    }
+
+    println!("[daemon] control={control_addr} session={session_addr} profile={}x{}fps", args.profile.max_w, args.profile.fps);
+    use std::io::Write as _;
+    std::io::stdout().flush().ok();
+
+    // ── 主线程驻留直到硬停(五段连锁第 4 段:进程零残留)──
+    while !killswitch.tripped() {
+        std::thread::sleep(Duration::from_millis(200));
+    }
+    eprintln!("[daemon] killswitch tripped, process exiting (port released, no residue)");
+    ExitCode::SUCCESS
+}
+
+/// 会话 acceptor:accept → 握手(保留对端公钥)→ Hello(device_id)→
+/// 双重校验(grant + 指纹 Required)→ 会话循环。
+async fn run_session_acceptor(
+    addr: std::net::SocketAddr,
+    shared: Arc<DaemonShared>,
+    backend: Arc<BackendSlot>,
+    fp_source: DirFpSource,
+) {
