+/// 被控端设备身份(Hello/审计用;测试面显式)。
+const DAEMON_DEVICE_ID: &str = "hv-control-daemon-demo";
+
+/// 帧源真实实现:锁后端 → GetImage 全屏捕获 → 降采样 → std-only PNG。
+/// 每次捕获后把原始屏幕几何回填 shared(§7.2 坐标换算终段用)。
+/// 桌面后端句柄:惰性连接 + 可失败(无 X11 平台控制面仍须可用)。
+///
+/// `Backend` 方法全为 `&self`,`Mutex` 仅用于惰性初始化缓存与失败原因留痕。
+struct BackendSlot {
+    #[cfg(unix)]
+    inner: Mutex<Option<Backend>>,
+    err: Mutex<Option<String>>,
+}
+
+impl BackendSlot {
+    #[cfg(unix)]
+    fn new() -> Self {
+        Self { inner: Mutex::new(None), err: Mutex::new(None) }
+    }
+
+    /// 非 unix 目标:无可编入的桌面后端,原因固定留痕(控制面/会话通道不受影响)。
+    #[cfg(not(unix))]
+    fn new() -> Self {
+        Self {
+            err: Mutex::new(Some(
+                "no desktop backend compiled in for this platform (X11 desktop backend is only built for unix targets)"
+                    .into(),
+            )),
+        }
+    }
+
+    /// 建立/复用后端连接;成功返回 true。已连接时幂等返回 true。
+    #[cfg(unix)]
+    fn try_connect(&self) -> bool {
+        if self.inner.lock().map(|g| g.is_some()).unwrap_or(false) {
+            return true;
+        }
+        match Backend::connect() {
+            Ok(b) => {
+                if let Ok(mut g) = self.inner.lock() {
+                    *g = Some(b);
+                }
+                if let Ok(mut e) = self.err.lock() {
+                    *e = None;
+                }
+                true
+            }
+            Err(e) => {
+                let msg = e.to_string();
+                if let Ok(mut m) = self.err.lock() {
+                    *m = Some(msg);
+                }
+                false
+            }
+        }
+    }
+
+    /// 非 unix 目标:恒不可用(无可编入后端)。
+    #[cfg(not(unix))]
+    fn try_connect(&self) -> bool {
+        false
+    }
+
+    /// 非 unix:采集/注入端点统一错误串(含门禁特征标记「desktop backend unavailable」)。
+    #[cfg(not(unix))]
+    fn unavailable(&self) -> String {
+        format!(
+            "desktop backend unavailable: {}",
+            self.last_error().unwrap_or_else(|| "unknown".into())
+        )
+    }
+
+    /// 借出后端执行 `f`;后端不可用(无 X11/连接失败)返回明确错误,不 panic。
+    #[cfg(unix)]
+    fn with<R>(&self, f: impl FnOnce(&Backend) -> R) -> Result<R, String> {
+        if !self.try_connect() {
+            let why = self
+                .err
+                .lock()
+                .ok()
+                .and_then(|g| g.clone())
+                .unwrap_or_else(|| "connect failed".into());
+            return Err(format!("desktop backend unavailable: {why}"));
+        }
+        let g = self.inner.lock().map_err(|e| format!("backend lock: {e}"))?;
+        let b = g
+            .as_ref()
+            .ok_or_else(|| "desktop backend unavailable".to_string())?;
+        Ok(f(b))
+    }
+
+    /// 当前连接失败原因(已连接则 None)。
+    fn last_error(&self) -> Option<String> {
+        self.err.lock().ok().and_then(|g| g.clone())
+    }
+
+    /// 已连接时返回屏幕几何(启动横幅用);非 unix 恒 None(无可编入后端)。
+    #[cfg(unix)]
+    fn describe(&self) -> Option<(u16, u16)> {
+        self.with(|b| (b.screen_w, b.screen_h)).ok()
+    }
+
+    #[cfg(not(unix))]
+    fn describe(&self) -> Option<(u16, u16)> {
+        None
+    }
+}
