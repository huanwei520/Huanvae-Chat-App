 /// 每次捕获后把原始屏幕几何回填 shared(§7.2 坐标换算终段用)。
+/// 桌面后端句柄:惰性连接 + 可失败(无 X11 平台控制面仍须可用)。
+///
+/// `Backend` 方法全为 `&self`,`Mutex` 仅用于惰性初始化缓存与失败原因留痕。
+struct BackendSlot {
+    inner: Mutex<Option<Backend>>,
+    err: Mutex<Option<String>>,
+}
+
+impl BackendSlot {
+    fn new() -> Self {
+        Self { inner: Mutex::new(None), err: Mutex::new(None) }
+    }
+
+    /// 建立/复用后端连接;成功返回 true。已连接时幂等返回 true。
+    fn try_connect(&self) -> bool {
+        if self.inner.lock().map(|g| g.is_some()).unwrap_or(false) {
+            return true;
+        }
+        match Backend::connect() {
+            Ok(b) => {
+                if let Ok(mut g) = self.inner.lock() {
+                    *g = Some(b);
+                }
+                if let Ok(mut e) = self.err.lock() {
+                    *e = None;
+                }
+                true
+            }
+            Err(e) => {
+                let msg = e.to_string();
+                if let Ok(mut m) = self.err.lock() {
+                    *m = Some(msg);
+                }
+                false
+            }
+        }
+    }
+
+    /// 借出后端执行 `f`;后端不可用(无 X11/连接失败)返回明确错误,不 panic。
+    fn with<R>(&self, f: impl FnOnce(&Backend) -> R) -> Result<R, String> {
+        if !self.try_connect() {
+            let why = self
+                .err
+                .lock()
+                .ok()
+                .and_then(|g| g.clone())
+                .unwrap_or_else(|| "connect failed".into());
+            return Err(format!("desktop backend unavailable: {why}"));
+        }
+        let g = self.inner.lock().map_err(|e| format!("backend lock: {e}"))?;
+        let b = g
+            .as_ref()
+            .ok_or_else(|| "desktop backend unavailable".to_string())?;
+        Ok(f(b))
+    }
+
+    /// 当前连接失败原因(已连接则 None)。
+    fn last_error(&self) -> Option<String> {
+        self.err.lock().ok().and_then(|g| g.clone())
+    }
+}
