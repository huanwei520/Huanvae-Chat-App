+async fn handle_session(
+    sock: TcpStream,
+    peer: std::net::SocketAddr,
+    shared: Arc<DaemonShared>,
+    backend: Arc<BackendSlot>,
+    anchoring: RequiredAnchoring<DirFpSource>,
+) -> std::io::Result<()> {
+    let mut sock = sock;
+    let kp = HandshakeKeypair::generate();
+    let (crypto, peer_public) =
+        match handshake_with_peer(&mut sock, kp, SESSION_ID, hv_protocol::crypto::Role::Responder).await {
+            Ok(x) => x,
+            Err(e) => {
+                eprintln!("[daemon] handshake {peer}: {e}");
+                return Ok(());
+            }
+        };
+    let presented_fp = session_fingerprint(&peer_public);
+    let mut chan = SecureChannel::new(sock, crypto);
+
+    // 首消息必须是 Hello{device_id}(握手后第一个消息,session.rs 语义)。
+    let device_id = match chan.recv().await {
+        Ok(SessionMsg::Hello { device_id }) => device_id,
+        Ok(_) => {
+            reject(&mut chan, "expect-hello", &shared).await;
+            return Ok(());
+        }
+        Err(e) => {
+            eprintln!("[daemon] recv hello {peer}: {e}");
+            return Ok(());
+        }
+    };
+
+    // 双重校验第 1 项(设计 §5.1):grant 活跃 + watcher_device 匹配。
+    // 锁中毒不 panic(panic Location 会把本文件路径串编入分发件——卡面判据
+    // 之一):into_inner 取回注册表尽力读取;校验失败仍走下方 unauthorized
+    // 拒绝路径,不静默放行。守卫不跨 await 持有。
+    let grant = {
+        let mut grants = match shared.grants.lock() {
+            Ok(g) => g,
+            Err(poisoned) => poisoned.into_inner(),
+        };
+        grants.active_for_device(&device_id, control::now_ms())
+    };
+    let grant = match grant {
+        Ok(g) => g,
+        Err(e) => {
+            shared.audit("offer-reject", format!("device={device_id} grant-check={e}"));
+            reject(&mut chan, "unauthorized", &shared).await;
+            return Ok(());
+        }
+    };
+
+    // 双重校验第 2 项(设计 §5.1):指纹锚定,策略恒 Required——
+    // 期望值查不到(AccessError::AnchorMissing)即拒,不静默降级。
+    if let Err(e) = anchoring.verify(&device_id, &presented_fp) {
+        shared.audit("offer-reject", format!("device={device_id} anchor={e}"));
+        reject(&mut chan, "anchor-rejected", &shared).await;
+        return Ok(());
+    }
+
+    shared.audit(
+        "session-start",
+        format!("peer={peer} device={device_id} grant={}", grant.grant_id),
+    );
+    // 对端通告本端身份(Hello 对称语义)。
+    let _ = chan.send(&SessionMsg::Hello { device_id: DAEMON_DEVICE_ID.into() }).await;
+
+    // teardown watch(N.2:sender 由 shared 具名持有;先复位再订阅)。
+    shared.teardown_tx.send_replace(false);
+    let teardown_rx = shared.teardown_tx.subscribe();
+
+    let gate: InputGate = shared.gate.clone();
+    // 注入汇与会话审计共用共享审计(触发窗日志全文可取证,§5.4①)。
+    let sink: Arc<dyn InputSink> = Arc::new(GatedSink {
+        gate: gate.clone(),
+        inner: XtestSink { backend: backend.clone() },
+        audit: shared.audit.clone(),
+        delivered: Arc::new(std::sync::atomic::AtomicU64::new(0)),
+    });
+    let audit = shared.audit.clone();
+    let max_w = shared.profile.max_w;
+    let capture_backend = backend.clone();
+    // 会话循环帧采集闭包:unix 走真实后端;非 unix 恒明确错误(会话通道仍可
+    // 建立,帧端按调用失败)。
+    #[cfg(unix)]
+    let mut capture = move || -> Result<Option<(u32, u32, Vec<u8>)>, String> {
+        let (w, h, rgba) = capture_backend
+            .with(|b| b.capture_screen_rgba())?
+            .map_err(|e| e.to_string())?;
+        Ok(Some(downscale_rgba(w, h, &rgba, max_w)))
+    };
+    #[cfg(not(unix))]
+    let mut capture = move || -> Result<Option<(u32, u32, Vec<u8>)>, String> {
+        Err(capture_backend.unavailable())
+    };
+
+    let cfg = SessionLoopConfig {
+        heartbeat_interval: crate::session_loop::HEARTBEAT_INTERVAL,
+        frame_interval: Some(shared.profile.frame_interval()),
+    };
+    let teardown = run_session(
+        chan, cfg, &gate, &shared.killswitch, sink, teardown_rx, audit, &mut capture,
+    ).await;
+    if let SessionTeardown::LeaseExpired | SessionTeardown::Disarmed = teardown {
+        // T11/T10:会话拆除 → grant 释放(dropped/share_stopped)。
+        // 锁中毒恢复:释放必须尽力执行(into_inner 取回注册表,不 panic)。
+        #[allow(unused_mut)]
+        let mut grants = match shared.grants.lock() {
+            Ok(g) => g,
+            Err(poisoned) => poisoned.into_inner(),
+        };
+        let reason = match teardown {
+            SessionTeardown::LeaseExpired => crate::grant::ReleaseReason::Network,
+            _ => crate::grant::ReleaseReason::ShareStopped,
+        };
+        let _ = grants.release(&grant.grant_id, reason, control::now_ms());
+    }
+    shared.audit("session-end", format!("device={device_id} reason={}", teardown.as_str()));
+    Ok(())
+}
+
+async fn reject(chan: &mut SecureChannel<TcpStream>, reason: &str, shared: &Arc<DaemonShared>) {
+    shared.audit("offer-reject", format!("reason={reason}"));
+    let _ = chan.send(&SessionMsg::Bye { reason: reason.to_string() }).await;
+}
