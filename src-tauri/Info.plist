<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 本地网络访问说明 (macOS 15+ 必需) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Huanvae Chat 使用本地网络发现附近设备并传输文件。此功能用于局域网文件互传。</string>
    
    <!-- Bonjour 服务类型声明 -->
    <key>NSBonjourServices</key>
    <array>
        <!-- 局域网传输服务 (mDNS 服务类型) -->
        <string>_hvae-xfer._tcp</string>
    </array>
    
    <!-- Touch ID / 生物识别用途说明（LocalAuthentication 解锁已保存的登录密码） -->
    <key>NSFaceIDUsageDescription</key>
    <string>Huanvae Chat 使用 Touch ID 验证你的身份，以解锁已保存的登录密码、免去每次手动输入。</string>

    <!-- 摄像头用途说明（视频通话 / 会议 getUserMedia，WKWebView WebRTC 必需） -->
    <key>NSCameraUsageDescription</key>
    <string>Huanvae Chat 使用摄像头进行视频通话与会议。</string>

    <!-- 麦克风用途说明（语音 / 视频通话 getUserMedia，WKWebView WebRTC 必需） -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Huanvae Chat 使用麦克风进行语音与视频通话。</string>

    <!-- 应用类别 -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.social-networking</string>
    
    <!-- 高分辨率支持 -->
    <key>NSHighResolutionCapable</key>
    <true/>
    
    <!-- 支持安全编码 -->
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    
    <key>NSSupportsSuddenTermination</key>
    <true/>
</dict>
</plist>
