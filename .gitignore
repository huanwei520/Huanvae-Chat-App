# Submodule docs (separate repo)
backend-docs/
# huanvaeguard-svc.exe: Windows VPN service binary, built from the standalone
# HuanvaeGuard workspace and fetched at build time by
# scripts/dev/fetch-hg-windows.mjs (sha256 pinned in
# src-tauri/resources/hg-windows.manifest.json). Never commit it.
# Deliberately file-specific rather than directory-wide: the sibling wintun.dll
# in the same directory IS tracked (third-party redistributable), and git cannot
# re-include a file whose parent directory is excluded. Full path prefix is kept
# so this never matches src/huanvaeGuard/* on a case-insensitive filesystem.
src-tauri/resources/HuanvaeGuard/huanvaeguard-svc.exe
# hg-macos: macOS VPN daemon binary, built from the standalone HuanvaeGuard
# workspace and fetched at build time by scripts/dev/fetch-hg-macos.mjs
# (sha256 pinned in src-tauri/resources/hg-macos.manifest.json). Never commit it.
# Deliberately file-specific rather than directory-wide: the sibling
# com.huanvaeguard.daemon.plist in the same directory IS tracked source, and git
# cannot re-include a file whose parent directory is excluded.
src-tauri/resources/HuanvaeGuard-macos/hg-macos
src-tauri/target/*/HuanvaeGuard/
# HuanvaeGuard standalone Rust workspace (separate repo) — 顶层目录，前导斜杠锚定根
# 仅匹配仓库根的 HuanvaeGuard/，不影响 src/huanvaeGuard/（前端 UI 源码）和 src-tauri/resources/HuanvaeGuard/（二进制资源）
/HuanvaeGuard/

data/

.tauri/

huanvae-chat-app.jks
huanvae-chat-app.jks.base64

# Android 签名配置
src-tauri/gen/android/app/keystore.properties

# Android build 期由 bundle.resources 复制进 assets/ 的运行时资源（每次构建重生成，不入 git）
# 注意：这是 Tauri build 流程的副产物，不是 Android 项目源文件
# HuanvaeGuard/ 资源已通过 tauri.windows.conf.json 限定为 Windows-only，Android build 不再生成
src-tauri/gen/android/app/src/main/assets/Notification-Sounds/

# Playwright
e2e/test-results/
playwright-report/
blob-report/

# Playwright snapshot — 仅保留 CI 平台基线（Linux），开发机生成的 win32/darwin 基线本地用不入库
# 避免不同开发者本机生成的快照互相覆盖造成无意义 diff
e2e/snapshots/**/*-chromium-win32.png
e2e/snapshots/**/*-chromium-darwin.png

# mTLS 客户端私钥 — 随二进制 include_bytes! 内置，本机 provision，绝不进 git/GitHub remote
# （公钥证书 *.cert.pem / huanvae-ca.pem 本就未 track；私钥再显式 ignore，防 git add -A 误暂存）
src-tauri/resources/app-client.key.pem

# Claude Code 本地权限白名单（每台机器独立，不入库）
.claude/settings.local.json

# 图标 squircle 中间产物 — 由 scripts/icons/make-squircle.py 从 image/IMG_1591.PNG 重新生成
# src-tauri/icons/ 下的派生图标才是真正参与构建的资源
scripts/icons/app-icon-squircle.png

# 构建产物安装包不入库（防手动测试构建的 .msi 误提交，2026-07 清理 test-build.msi 后加）
/*.msi

