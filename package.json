{
  "name": "Huanvae-Chat-App",
  "private": true,
  "version": "1.1.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/dev/pre-tauri.mjs && tauri",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:strict": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:animation": "playwright test --project=animation-health",
    "test:visual": "playwright test --project=chromium visual-regression",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run",
    "hg:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hg-service.ps1 -Action install",
    "hg:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hg-service.ps1 -Action uninstall",
    "hg:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hg-service.ps1 -Action start",
    "hg:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hg-service.ps1 -Action stop",
    "hg:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hg-service.ps1 -Action restart",
    "hg:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hg-service.ps1 -Action status",
    "hg:diag": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hg-tunnel-diag.ps1"
  },
  "dependencies": {
    "@kingsword/tauri-plugin-android-package-install": "jsr:^2.0.1",
    "@kingsword/tauri-plugin-mobile-onbackpressed-listener": "jsr:^2.0.1",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-http": "^2.5.6",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@xyflow/react": "^12.10.0",
    "better-react-mathjax": "2.4.0-beta-1",
    "culori": "^4.0.2",
    "dagre": "^0.8.5",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "liquid-glass-tailwind-react": "^1.0.56",
    "mermaid": "^11.12.2",
    "react": "^19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tauri-plugin-android-fs-api": "^24.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/culori": "^4.0.1",
    "@types/dagre": "^0.7.53",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.4",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
